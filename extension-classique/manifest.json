{
  "manifest_version": 3,
  "name": "Deezer Classique",
  "version": "0.10.1",
  "description": "Recherche classique pour Deezer : compositeurs, œuvres, interprètes, tempo (Open Opus, MusicBrainz).",
  "permissions": [
    "storage",
    "unlimitedStorage",
    "declarativeNetRequestWithHostAccess"
  ],
  "host_permissions": [
    "https://api.deezer.com/*",
    "https://musicbrainz.org/*",
    "https://api.openopus.org/*",
    "https://www.deezer.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.deezer.com/*"
      ],
      "js": [
        "styles.js",
        "works.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Deezer Classique"
  },
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  }
}
